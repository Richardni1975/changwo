/* 畅吾欲言 — 历史记录页样式 */

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-surface-bg);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ─── 头部 ──────────────────────────────────── */
.header {
  padding: 48rpx 48rpx 32rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: var(--color-text-muted);
}

/* ─── 空状态 ────────────────────────────────── */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 48rpx;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 32rpx;
  color: var(--color-text-secondary);
}

.empty-hint {
  font-size: 26rpx;
  color: var(--color-text-muted);
  text-align: center;
}

/* ─── 历史列表 ──────────────────────────────── */
.history-list {
  flex: 1;
  padding: 0 48rpx 32rpx;
}

.history-item {
  margin-bottom: 32rpx;
}

.history-time {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-bottom: 12rpx;
  display: block;
}

/* ─── 操作栏 ────────────────────────────────── */
.action-bar {
  padding: 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.action-bar .btn-primary {
  width: 100%;
}

.record-count {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

/* 畅吾欲言 — 创建房间页样式 */

.page-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 48rpx;
  box-sizing: border-box;
}

/* ─── Hero ─────────────────────────────────── */
.hero-section {
  text-align: center;
  margin-bottom: 80rpx;
}

.hero-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 32rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 16rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

/* ─── 特性网格 ─────────────────────────────── */
.feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  width: 100%;
  max-width: 600rpx;
  margin-bottom: 72rpx;
}

.feature-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: var(--color-surface-card);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  box-sizing: border-box;
}

.feature-icon {
  font-size: 36rpx;
}

.feature-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* ─── 创建按钮 ─────────────────────────────── */
.create-btn {
  width: 100%;
  max-width: 600rpx;
  padding: 32rpx;
  border-radius: 100rpx;
  font-size: 34rpx;
}

.create-btn[disabled] {
  opacity: 0.5;
}

/* ─── 免责声明 ─────────────────────────────── */
.disclaimer {
  margin-top: 32rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

/* 畅吾欲言 — 房间页样式 */

.page-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-surface-bg);
}

/* ─── 满员覆盖层 ───────────────────────────── */
.room-full-overlay {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 48rpx;
}

.room-full-icon {
  font-size: 100rpx;
}

.room-full-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.room-full-desc {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 32rpx;
}

/* ─── 顶部栏 ────────────────────────────────── */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  flex-shrink: 0;
}

.back-btn,
.export-btn {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  padding: 8rpx 0;
}

.room-info {
  text-align: center;
}

.room-id {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
}

.online-count {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

/* ─── 消息列表 ──────────────────────────────── */
.message-list {
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
}

.message-item {
  margin-bottom: 24rpx;
}

.message-ready {
  display: flex;
  flex-direction: column;
}

.collecting-text {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-left: 12rpx;
}

/* ─── 输入栏 ────────────────────────────────── */
.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(10px);
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  height: 72rpx;
}

.send-btn {
  flex-shrink: 0;
  padding: 18rpx 36rpx;
  border-radius: 100rpx;
  background: var(--color-brand-primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  line-height: 1;
}

.send-btn[disabled] {
  opacity: 0.3;
}

.send-btn:active {
  opacity: 0.8;
}
